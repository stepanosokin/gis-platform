{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "server", "sources", "providers", "publications"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "server": {
      "type": "object",
      "required": ["host", "port"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "maxLength": 253, "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tls": {
          "type": "object",
          "required": ["cert_file", "key_file"],
          "additionalProperties": false,
          "properties": {
            "cert_file": { "type": "string", "minLength": 1 },
            "key_file": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["mode", "secret_file", "postgres_password_file"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["development", "production"] },
        "secret_file": { "type": "string", "minLength": 1 },
        "postgres_password_file": { "type": "string", "minLength": 1 },
        "administrator_emails": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 254, "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$" }
        },
        "cli": {
          "type": "object",
          "required": ["port", "ca_file", "cert_file", "key_file", "operators"],
          "additionalProperties": false,
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "ca_file": { "type": "string", "minLength": 1 },
            "cert_file": { "type": "string", "minLength": 1 },
            "key_file": { "type": "string", "minLength": 1 },
            "operators": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["diagnostics", "users-read", "access-write"] }
              }
            }
          }
        },
        "mailpit_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "smtp": {
          "type": "object",
          "required": ["host", "port", "from"],
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "from": { "type": "string", "minLength": 1 },
            "secure": { "type": "boolean" },
            "username": { "type": "string", "minLength": 1 },
            "password_file": { "type": "string", "minLength": 1 }
          },
          "dependencies": { "username": ["password_file"], "password_file": ["username"] }
        }
      },
      "if": { "properties": { "mode": { "const": "production" } } },
      "then": { "required": ["smtp"], "properties": { "mailpit_port": false } },
      "else": { "properties": { "smtp": false } }
    },
    "sources": {
      "allOf": [{ "$ref": "#/$defs/singleEntry" }],
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "path"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "geojson" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "providers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "pygeoapi" },
          "image": { "type": "string", "maxLength": 512 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "api": {
            "type": "object",
            "required": ["protocol", "scheme", "port", "base_path", "public_root", "links", "readiness"],
            "additionalProperties": false,
            "properties": {
              "protocol": { "const": "features" },
              "scheme": { "const": "http" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "base_path": { "type": "string", "pattern": "^/(?:[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)*)?$" },
              "public_root": { "type": "string", "pattern": "^/[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)*$" },
              "links": { "const": "canonical" },
              "readiness": { "type": "string", "pattern": "^/[a-z][a-z0-9/-]*(?:\\?f=json)?$" }
            }
          },
          "environment": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
            "additionalProperties": { "type": "string" }
          },
          "volumes": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/id" },
            "additionalProperties": { "type": "string", "pattern": "^/(?:[a-zA-Z0-9_.-]+/)*[a-zA-Z0-9_.-]+$" }
          }
        },
        "if": { "required": ["image"] },
        "then": { "required": ["api"] },
        "else": { "properties": { "digest": false, "api": false, "environment": false, "volumes": false } }
      }
    },
    "publications": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["source", "provider", "protocol", "access", "title", "description", "extent"],
        "additionalProperties": false,
        "properties": {
          "source": { "$ref": "#/$defs/id" },
          "provider": { "$ref": "#/$defs/id" },
          "protocol": { "const": "features" },
          "access": { "enum": ["public", "registered", "private"] },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "extent": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": [
              { "type": "number", "minimum": -180, "maximum": 180 },
              { "type": "number", "minimum": -90, "maximum": 90 },
              { "type": "number", "minimum": -180, "maximum": 180 },
              { "type": "number", "minimum": -90, "maximum": 90 }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "singleEntry": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "minProperties": 1,
      "maxProperties": 1
    }
  }
}
